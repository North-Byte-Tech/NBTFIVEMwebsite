// Website accounts database - Postgres, owned entirely by `web`. This used
// to be paired with a separate portal-api service that bridged to the
// FiveM/SFOS MySQL game database (game accounts, characters, staff roster,
// bans, etc); portal-api has been retired and every admin feature below is
// now backed by this Postgres database alone. There is no more link to live
// game-server data (no game account id, no character roster) - a website
// User row IS the account.
//
// Account/Session/VerificationToken below are the exact shape
// @next-auth/prisma-adapter requires (https://authjs.dev/reference/adapter/prisma).
// User is that same contract plus FMRP-specific columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Discord's numeric user id, set from the OAuth profile at first sign-in
  // (see lib/auth.ts's DiscordProvider profile() override) - kept as its
  // own column so reading it never needs a join through Account.
  discordId String? @unique

  // Site-admin state, managed entirely through this app's own /admin UI
  // (lib/adminData.ts) - not re-derived from anywhere external anymore.
  isStaff     Boolean  @default(false)
  permissions String[] @default([])

  accounts Account[]
  sessions Session[]

  ban         Ban?
  staffMember StaffMember?
  playerNotes PlayerNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ApplicationStatus {
  pending
  interview_scheduled
  interview_completed
  awaiting_final_decision
  accepted
  rejected
}

// A department recruitment application, submitted by any signed-in Discord
// user (see app/api/applications/route.ts) - not tied to a User row by
// foreign key so a submission always succeeds even for an applicant with no
// prior sign-in, matching the old portal-api behaviour.
model Application {
  id              String            @id @default(cuid())
  discordId       String
  discordUsername String
  department      String
  answers         Json
  status          ApplicationStatus @default(pending)
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?

  // Plain audit-trail strings, not a foreign key - kept consistent with
  // Ban.bannedById/StaffMember.appointedById/PlayerNote.authorId below, and
  // deliberately not enforced against User so a review still records who
  // did it even if that admin's account is later deleted (and so this keeps
  // working under DEV_BYPASS_AUTH's fake, non-persisted actor id).
  reviewedById   String?
  reviewedByName String?

  @@index([discordId])
  @@index([status])
}

// One row per currently-banned user - unbanning deletes the row (history of
// past bans lives in AuditLog instead, matching portal-api's boolean
// is_banned column rather than a ban-history table).
model Ban {
  userId String @id

  reason    String
  bannedAt  DateTime  @default(now())
  expiresAt DateTime?

  bannedById   String?
  bannedByName String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlayerNote {
  id        String   @id @default(cuid())
  userId    String
  note      String
  createdAt DateTime @default(now())

  authorId   String?
  authorName String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per staff appointment - removing staff deletes the row (past
// appointments live in AuditLog).
model StaffMember {
  userId String @id

  title       String
  notes       String?
  appointedAt DateTime @default(now())

  appointedById   String?
  appointedByName String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Append-only admin action log - replaces portal-api's staff_actions table.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// A staff Doc Center article (/admin/docs), written in Markdown through the
// admin UI. Built-in articles that ship with the code live in
// lib/builtinDocs.ts instead and reserve their slugs - see lib/docs.ts.
model Doc {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  category String
  summary  String?
  body     String  @db.Text
  pinned   Boolean @default(false)

  // Audit-trail strings, not foreign keys - same reasoning as Application.
  createdById   String?
  createdByName String?
  updatedById   String?
  updatedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}
