# Dev-only: when unset (or anything other than "false") and NODE_ENV isn't
# "production", every page/API route sees a fixed fake signed-in session
# instead of calling next-auth/Prisma at all - see lib/session.ts. Lets
# `next dev` run fully click-through-able with no Postgres DB or Discord
# OAuth app configured. Set to "false" to exercise the real Discord sign-in
# flow locally instead (then the vars below need real values).
DEV_BYPASS_AUTH=

# Hosts where Discord sign-in is skipped and EVERY visitor is treated as a
# site admin (no Dev Dashboard) - see lib/session.ts. Defaults to
# "fmrp.northbytetech.com" when unset; set to an empty value to turn the
# bypass off everywhere. Anyone who can open a listed host can use the whole
# admin panel against this app's database.
# AUTH_BYPASS_HOSTS=fmrp.northbytetech.com

# Website database - Postgres, the sole datastore for this app. Signing in
# with Discord creates/loads a row here, and every admin feature (staff,
# bans, notes, permissions, and applications) lives here
# too - see prisma/schema.prisma and lib/auth.ts. There is no other service
# behind this app. Any Postgres works (a free Neon or Vercel Postgres
# instance is the easiest path in production); for local dev, point this at
# a local Postgres and run `pnpm --filter fmrp-web exec prisma migrate deploy`
# once to create the tables.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fmrp_web?schema=public

# NextAuth - generate a random string for NEXTAUTH_SECRET (e.g. `openssl
# rand -base64 32`). NEXTAUTH_URL must match wherever this app is actually
# served (http://localhost:3000 for local dev; your real domain in Vercel).
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# From a Discord application at https://discord.com/developers/applications
# (OAuth2 tab). Add a redirect URI there matching:
#   {NEXTAUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bootstrap for the very first site admin - see lib/auth.ts's
# loadAdminBootstrapIds(). Any Discord id listed here gets fmrp.staff.admin
# granted automatically on sign-in if it doesn't already have it; it's
# additive and idempotent, safe to leave set permanently for whoever should
# always have admin. Everyone else's permissions are managed entirely
# through the /admin UI once at least one admin exists.
# Format: "discordId,discordId2"
ADMIN_BOOTSTRAP_DISCORD_IDS=

# Public recruitment Discord invite shown on the public site. Keep this
# separate from the main community server invite, which should only be sent
# privately after an applicant is accepted.
NEXT_PUBLIC_RECRUITMENT_DISCORD_URL=

# Optional direct webhook to the Discord bot for application lifecycle
# notifications (applicant DMs and acceptance roles). Keep the URL reachable
# from the web server; the secret must match DISCORD_RECRUITMENT_SECRET in the
# bot's environment. The bot defaults to http://localhost:30121 if URL unset.
DISCORD_BOT_WEBHOOK_URL=http://localhost:30121
DISCORD_BOT_WEBHOOK_SECRET=
